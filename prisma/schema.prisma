generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String
  type  String  // "physical" ou "digital" 
  price Float
}

model Order {
  id         Int      @id @default(autoincrement())
  customer   String
  items      OrderItem[]   // Armazenado como JSON string para simplificar o lab
  total      Float
  freight    Float 
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  productId Int
  quantity  Int
  price     Float
}